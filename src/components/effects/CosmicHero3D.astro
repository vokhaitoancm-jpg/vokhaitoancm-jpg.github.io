<div class="relative w-full h-[380px] sm:h-[480px] lg:h-[540px] flex items-center justify-center">
  <!-- 3D Three.js Container -->
  <div id="three-hero-container" class="absolute inset-0 w-full h-full"></div>

  <!-- Fallback / Ambient Glow overlay -->
  <div
    id="hero-fallback"
    class="absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-700"
    aria-hidden="true"
  >
    <div class="w-64 h-64 sm:w-80 sm:h-80 rounded-full border border-cosmic-cyan/30 animate-pulse-slow relative flex items-center justify-center">
      <div class="w-48 h-48 sm:w-60 sm:h-60 rounded-full border border-dashed border-cosmic-violet/40 animate-orbit-spin"></div>
      <div class="w-24 h-24 rounded-full bg-cosmic-cyan/10 blur-xl"></div>
    </div>
  </div>

  <!-- HUD Hologram Markers around the 3D Sphere -->
  <div class="absolute inset-x-4 top-4 sm:top-8 flex justify-between pointer-events-none font-mono text-[10px] sm:text-xs text-cosmic-muted/60">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-cosmic-cyan animate-ping"></span>
      <span>ORBIT-RAD: 6,378 KM</span>
    </div>
    <div class="text-right">
      <span>T-EPOCH: UTC 2026</span>
    </div>
  </div>

  <div class="absolute inset-x-4 bottom-4 sm:bottom-8 flex justify-between pointer-events-none font-mono text-[10px] sm:text-xs text-cosmic-muted/60">
    <div>
      <span>AZ: 142.04° // EL: +45.2°</span>
    </div>
    <div class="text-cosmic-cyan/80">
      <span>SIGNAL-LOCK: 99.8%</span>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  (function initThreeHero() {
    const container = document.getElementById('three-hero-container');
    const fallback = document.getElementById('hero-fallback');
    if (!container) return;

    // Check reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    try {
      const scene = new THREE.Scene();

      const camera = new THREE.PerspectiveCamera(
        50,
        container.clientWidth / container.clientHeight,
        0.1,
        1000
      );
      camera.position.z = 7;

      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'high-performance' });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      // Hide fallback when Three.js succeeds
      if (fallback) fallback.style.opacity = '0.35';

      // Group to rotate together
      const cosmicGroup = new THREE.Group();
      scene.add(cosmicGroup);

      // 1. Inner Core: Wireframe Icosahedron
      const coreGeo = new THREE.IcosahedronGeometry(1.6, 2);
      const coreMat = new THREE.MeshBasicMaterial({
        color: 0x4debff,
        wireframe: true,
        transparent: true,
        opacity: 0.25,
      });
      const coreMesh = new THREE.Mesh(coreGeo, coreMat);
      cosmicGroup.add(coreMesh);

      // 2. Central Glow Sphere (Points)
      const glowGeo = new THREE.IcosahedronGeometry(1.2, 3);
      const glowMat = new THREE.PointsMaterial({
        color: 0x9b6dff,
        size: 0.04,
        transparent: true,
        opacity: 0.7,
      });
      const glowPoints = new THREE.Points(glowGeo, glowMat);
      cosmicGroup.add(glowPoints);

      // 3. Orbital Ring 1
      const ring1Geo = new THREE.RingGeometry(2.4, 2.45, 64);
      const ring1Mat = new THREE.MeshBasicMaterial({
        color: 0x4debff,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.5,
      });
      const ring1 = new THREE.Mesh(ring1Geo, ring1Mat);
      ring1.rotation.x = Math.PI / 2.5;
      ring1.rotation.y = Math.PI / 6;
      cosmicGroup.add(ring1);

      // 4. Orbital Ring 2 (Tilted)
      const ring2Geo = new THREE.RingGeometry(3.1, 3.13, 64);
      const ring2Mat = new THREE.MeshBasicMaterial({
        color: 0xffca80,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.35,
      });
      const ring2 = new THREE.Mesh(ring2Geo, ring2Mat);
      ring2.rotation.x = Math.PI / 1.7;
      ring2.rotation.y = -Math.PI / 4;
      cosmicGroup.add(ring2);

      // 5. Data Packet Satellites on Orbit
      const satGeo = new THREE.SphereGeometry(0.08, 16, 16);
      const satMat = new THREE.MeshBasicMaterial({ color: 0x4debff });
      const satellite1 = new THREE.Mesh(satGeo, satMat);
      cosmicGroup.add(satellite1);

      const sat2Mat = new THREE.MeshBasicMaterial({ color: 0xffca80 });
      const satellite2 = new THREE.Mesh(satGeo, sat2Mat);
      cosmicGroup.add(satellite2);

      // 6. Constellation Particle Cloud
      const particleCount = 200;
      const partGeo = new THREE.BufferGeometry();
      const positions = new Float32Array(particleCount * 3);
      for (let i = 0; i < particleCount * 3; i += 3) {
        positions[i] = (Math.random() - 0.5) * 8;
        positions[i + 1] = (Math.random() - 0.5) * 8;
        positions[i + 2] = (Math.random() - 0.5) * 8;
      }
      partGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const partMat = new THREE.PointsMaterial({
        color: 0x4debff,
        size: 0.03,
        transparent: true,
        opacity: 0.6,
      });
      const particleCloud = new THREE.Points(partGeo, partMat);
      scene.add(particleCloud);

      // Interactive mouse parallax
      let mouseX = 0;
      let mouseY = 0;
      let targetX = 0;
      let targetY = 0;

      window.addEventListener('mousemove', (e) => {
        const halfWidth = window.innerWidth / 2;
        const halfHeight = window.innerHeight / 2;
        mouseX = (e.clientX - halfWidth) / halfWidth;
        mouseY = (e.clientY - halfHeight) / halfHeight;
      });

      // Handle Resize
      const onResize = () => {
        if (!container) return;
        const width = container.clientWidth;
        const height = container.clientHeight;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      };
      window.addEventListener('resize', onResize);

      // Animation Loop
      let animId: number;
      let clock = new THREE.Clock();

      function animate() {
        animId = requestAnimationFrame(animate);
        const elapsedTime = clock.getElapsedTime();

        // Parallax easing
        targetX += (mouseX * 0.4 - targetX) * 0.05;
        targetY += (mouseY * 0.4 - targetY) * 0.05;

        cosmicGroup.rotation.y = elapsedTime * 0.15 + targetX;
        cosmicGroup.rotation.x = targetY;

        coreMesh.rotation.y = -elapsedTime * 0.1;
        coreMesh.rotation.x = elapsedTime * 0.05;

        glowPoints.rotation.y = elapsedTime * 0.2;

        ring1.rotation.z = elapsedTime * 0.1;
        ring2.rotation.z = -elapsedTime * 0.08;

        // Animate satellites on circular trajectories
        const angle1 = elapsedTime * 0.8;
        satellite1.position.set(
          Math.cos(angle1) * 2.42,
          Math.sin(angle1) * 2.42 * 0.4,
          Math.sin(angle1) * 2.42 * 0.8
        );

        const angle2 = -elapsedTime * 0.6;
        satellite2.position.set(
          Math.cos(angle2) * 3.11 * 0.7,
          Math.sin(angle2) * 3.11 * 0.9,
          Math.sin(angle2) * 3.11 * 0.3
        );

        particleCloud.rotation.y = -elapsedTime * 0.03;

        renderer.render(scene, camera);
      }

      animate();

      // Lifecycle visibility pause
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(animId);
        } else {
          animate();
        }
      });
    } catch (e) {
      console.warn('Three.js initialization skipped, fallback active', e);
      if (fallback) fallback.style.opacity = '1';
    }
  })();
</script>
