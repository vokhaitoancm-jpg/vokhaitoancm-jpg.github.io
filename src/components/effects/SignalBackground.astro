<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <!-- CSS Nebula Glows -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-cyan-500/10 rounded-full blur-[120px]"></div>
  <div class="absolute top-1/3 -right-40 w-96 h-96 bg-purple-600/10 rounded-full blur-[140px]"></div>
  <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-blue-600/10 rounded-full blur-[130px]"></div>
  
  <!-- Star Canvas -->
  <canvas id="cosmic-bg-canvas" class="absolute inset-0 w-full h-full opacity-60"></canvas>
  <div class="absolute inset-0 cosmic-grid opacity-30"></div>
</div>

<script>
  (function initCosmicBackground() {
    const canvas = document.getElementById('cosmic-bg-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Respect reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const numStars = Math.min(100, Math.floor((width * height) / 12000));
    const stars: Array<{
      x: number;
      y: number;
      size: number;
      speed: number;
      opacity: number;
      targetOpacity: number;
      pulseSpeed: number;
      color: string;
    }> = [];

    const colors = ['#4debff', '#9b6dff', '#eaf3ff', '#ffffff'];

    for (let i = 0; i < numStars; i++) {
      stars.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 1.5 + 0.5,
        speed: Math.random() * 0.15 + 0.05,
        opacity: Math.random() * 0.8 + 0.2,
        targetOpacity: Math.random() * 0.8 + 0.2,
        pulseSpeed: Math.random() * 0.02 + 0.005,
        color: colors[Math.floor(Math.random() * colors.length)],
      });
    }

    let animationId: number;

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        s.y -= s.speed;
        if (s.y < 0) {
          s.y = height;
          s.x = Math.random() * width;
        }

        // Twinkle
        if (Math.abs(s.opacity - s.targetOpacity) < 0.05) {
          s.targetOpacity = Math.random() * 0.8 + 0.2;
        } else {
          s.opacity += (s.targetOpacity - s.opacity) * s.pulseSpeed;
        }

        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fillStyle = s.color;
        ctx.globalAlpha = Math.max(0.1, Math.min(1, s.opacity));
        ctx.fill();
      }

      animationId = requestAnimationFrame(render);
    }

    render();

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(animationId);
      } else {
        render();
      }
    });
  })();
</script>
