---
interface Props {
  class?: string;
  glow?: boolean;
}

const { class: className = '', glow = false } = Astro.props;
---

<div
  class={`relative glass-panel rounded-lg p-5 sm:p-6 transition-all duration-300 hud-corner ${
    glow ? 'glass-panel-hover' : ''
  } ${className}`}
>
  <slot />
</div>
