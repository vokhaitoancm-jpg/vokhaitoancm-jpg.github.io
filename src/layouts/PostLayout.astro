---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import { siteConfig } from '../data/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  category: string;
  slug: string;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  category = 'Technology',
  prevPost,
  nextPost,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumb & Back -->
    <div class="mb-8 flex items-center justify-between text-xs font-mono">
      <a
        href="/posts/"
        class="inline-flex items-center gap-2 text-cosmic-muted hover:text-cosmic-cyan transition-colors group"
      >
        <span class="text-cosmic-cyan transition-transform group-hover:-translate-x-1">‹</span>
        <span>TRỞ VỀ ARCHIVE TÍN HIỆU</span>
      </a>

      <div class="flex items-center gap-2 text-cosmic-muted">
        <span class="w-2 h-2 rounded-full bg-cosmic-cyan animate-pulse"></span>
        <span class="uppercase tracking-widest">{category}</span>
      </div>
    </div>

    <!-- Article Header HUD -->
    <header class="glass-panel p-6 sm:p-8 rounded-xl border border-cosmic-cyan/20 mb-10 relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-cosmic-cyan/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-wrap items-center gap-2 mb-4">
        <Badge variant="cyan">{category}</Badge>
        <span class="text-xs font-mono text-cosmic-muted">
          // NGÀY TRUYỀN PHÁT: {formattedDate}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-heading font-bold text-cosmic-text mb-4 leading-tight">
        {title}
      </h1>

      <p class="text-sm sm:text-base text-cosmic-muted leading-relaxed font-sans mb-6">
        {description}
      </p>

      <!-- Tags & Meta -->
      <div class="pt-4 border-t border-cosmic-cyan/15 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-cosmic-muted">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-cosmic-cyan">TAGS:</span>
          {tags.map((tag) => (
            <a
              href={`/posts/?tag=${encodeURIComponent(tag)}`}
              class="px-2 py-0.5 rounded bg-space-800 border border-cosmic-cyan/20 hover:border-cosmic-cyan text-cosmic-muted hover:text-cosmic-cyan transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>

        <button
          id="copy-link-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-space-800 border border-cosmic-cyan/30 text-cosmic-cyan hover:bg-cosmic-cyan hover:text-space-950 transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="copy-btn-text">Sao chép link</span>
        </button>
      </div>
    </header>

    <!-- Post Content -->
    <article class="prose prose-invert prose-cyan max-w-none text-cosmic-text leading-relaxed font-sans space-y-6 text-sm sm:text-base [&>h1]:text-2xl [&>h1]:font-heading [&>h1]:text-cosmic-cyan [&>h1]:mt-8 [&>h1]:mb-4 [&>h2]:text-xl [&>h2]:font-heading [&>h2]:text-cosmic-text [&>h2]:mt-8 [&>h2]:mb-3 [&>h2]:border-b [&>h2]:border-cosmic-cyan/15 [&>h2]:pb-2 [&>h3]:text-lg [&>h3]:text-cosmic-amber [&>h3]:mt-6 [&>p]:leading-relaxed [&>p]:text-slate-300 [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-2 [&>ol]:list-decimal [&>ol]:pl-6 [&>blockquote]:border-l-4 [&>blockquote]:border-cosmic-cyan [&>blockquote]:bg-space-800/60 [&>blockquote]:p-4 [&>blockquote]:rounded-r [&>blockquote]:italic [&>blockquote]:text-cosmic-muted [&>table]:w-full [&>table]:border [&>table]:border-cosmic-cyan/20 [&_th]:bg-space-800 [&_th]:p-2.5 [&_th]:text-left [&_td]:border-t [&_td]:border-cosmic-cyan/10 [&_td]:p-2.5">
      <slot />
    </article>

    <!-- Post Navigation -->
    <nav class="mt-16 pt-8 border-t border-cosmic-cyan/20 grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs">
      {prevPost ? (
        <a
          href={`/posts/${prevPost.slug}/`}
          class="glass-panel p-4 rounded-lg border border-cosmic-cyan/15 hover:border-cosmic-cyan/50 transition-colors flex flex-col gap-1 group text-left"
        >
          <span class="text-cosmic-cyan text-[11px] group-hover:-translate-x-1 transition-transform">‹ BÀI VIẾT TRƯỚC</span>
          <span class="text-cosmic-text font-semibold line-clamp-1 group-hover:text-cosmic-cyan transition-colors">{prevPost.title}</span>
        </a>
      ) : <div />}

      {nextPost && (
        <a
          href={`/posts/${nextPost.slug}/`}
          class="glass-panel p-4 rounded-lg border border-cosmic-cyan/15 hover:border-cosmic-cyan/50 transition-colors flex flex-col gap-1 group text-right sm:items-end"
        >
          <span class="text-cosmic-cyan text-[11px] group-hover:translate-x-1 transition-transform">BÀI VIẾT TIẾP THEO ›</span>
          <span class="text-cosmic-text font-semibold line-clamp-1 group-hover:text-cosmic-cyan transition-colors">{nextPost.title}</span>
        </a>
      )}
    </nav>
  </div>
</BaseLayout>

<script>
  // Copy link handler
  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-btn-text');
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyText.textContent = 'Đã sao chép!';
        setTimeout(() => {
          copyText.textContent = 'Sao chép link';
        }, 2000);
      } catch (e) {
        console.error('Failed to copy', e);
      }
    });
  }

  // Add copy button to pre code blocks
  document.querySelectorAll('pre').forEach((block) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'relative group';
    block.parentNode?.insertBefore(wrapper, block);
    wrapper.appendChild(block);

    const btn = document.createElement('button');
    btn.className =
      'absolute top-2 right-2 px-2 py-1 text-[11px] font-mono bg-space-850/80 border border-cosmic-cyan/30 text-cosmic-cyan rounded opacity-0 group-hover:opacity-100 transition-opacity focus:opacity-100';
    btn.textContent = 'COPY';
    btn.type = 'button';

    btn.addEventListener('click', async () => {
      const code = block.querySelector('code')?.innerText || block.innerText;
      await navigator.clipboard.writeText(code);
      btn.textContent = 'COPIED!';
      setTimeout(() => {
        btn.textContent = 'COPY';
      }, 2000);
    });

    wrapper.appendChild(btn);
  });
</script>
