---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  category: string;
  status: 'ONLINE' | 'IN ORBIT' | 'PROTOTYPE' | 'ARCHIVED';
  demoUrl?: string;
  githubUrl?: string;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  category = 'Web',
  status = 'ONLINE',
  demoUrl,
  githubUrl,
} = Astro.props;

const statusColors = {
  ONLINE: 'emerald' as const,
  'IN ORBIT': 'cyan' as const,
  PROTOTYPE: 'amber' as const,
  ARCHIVED: 'violet' as const,
};
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Back to projects -->
    <div class="mb-8 flex items-center justify-between text-xs font-mono">
      <a
        href="/projects/"
        class="inline-flex items-center gap-2 text-cosmic-muted hover:text-cosmic-cyan transition-colors group"
      >
        <span class="text-cosmic-cyan transition-transform group-hover:-translate-x-1">‹</span>
        <span>TRỞ VỀ DANH MỤC DỰ ÁN</span>
      </a>

      <Badge variant={statusColors[status]}>
        STATUS: {status}
      </Badge>
    </div>

    <!-- Case Study Header -->
    <header class="glass-panel p-6 sm:p-8 rounded-xl border border-cosmic-cyan/20 mb-10 relative overflow-hidden">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <Badge variant="cyan">{category}</Badge>
        <span class="text-xs font-mono text-cosmic-muted">
          // THI CÔNG: {pubDate.getFullYear()}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-heading font-bold text-cosmic-text mb-4 leading-tight">
        {title}
      </h1>

      <p class="text-sm sm:text-base text-cosmic-muted leading-relaxed font-sans mb-6">
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-cosmic-cyan/15">
        {demoUrl && (
          <Button href={demoUrl} variant="primary" size="sm">
            <span>MỞ TRẢI NGHIỆM DEMO</span>
            <span>↗</span>
          </Button>
        )}
        {githubUrl && (
          <Button href={githubUrl} variant="secondary" size="sm" target="_blank" rel="noopener noreferrer">
            <span>MÃ NGUỒN GITHUB</span>
            <span>↗</span>
          </Button>
        )}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-mono">
        <span class="text-cosmic-cyan">CÔNG NGHỆ:</span>
        {tags.map((t) => (
          <span class="px-2 py-0.5 rounded bg-space-800 text-slate-300 border border-cosmic-cyan/15">
            {t}
          </span>
        ))}
      </div>
    </header>

    <!-- Case Study Content -->
    <article class="prose prose-invert prose-cyan max-w-none text-cosmic-text leading-relaxed font-sans space-y-6 text-sm sm:text-base [&>h1]:text-2xl [&>h1]:font-heading [&>h1]:text-cosmic-cyan [&>h1]:mt-8 [&>h1]:mb-4 [&>h2]:text-xl [&>h2]:font-heading [&>h2]:text-cosmic-text [&>h2]:mt-8 [&>h2]:mb-3 [&>h2]:border-b [&>h2]:border-cosmic-cyan/15 [&>h2]:pb-2 [&>h3]:text-lg [&>h3]:text-cosmic-amber [&>h3]:mt-6 [&>p]:leading-relaxed [&>p]:text-slate-300 [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-2 [&>blockquote]:border-l-4 [&>blockquote]:border-cosmic-cyan [&>blockquote]:bg-space-800/60 [&>blockquote]:p-4 [&>blockquote]:rounded-r [&>blockquote]:italic">
      <slot />
    </article>
  </div>
</BaseLayout>
