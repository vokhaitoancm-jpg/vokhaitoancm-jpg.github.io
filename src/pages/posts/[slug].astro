---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // Only publish non-draft posts
  const publishedPosts = posts
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return publishedPosts.map((post, index) => {
    const prevPost = index < publishedPosts.length - 1 ? publishedPosts[index + 1] : null;
    const nextPost = index > 0 ? publishedPosts[index - 1] : null;

    return {
      params: { slug: post.id },
      props: {
        post,
        prevPost: prevPost ? { slug: prevPost.id, title: prevPost.data.title } : null,
        nextPost: nextPost ? { slug: nextPost.id, title: nextPost.data.title } : null,
      },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  category={post.data.category}
  slug={post.id}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</PostLayout>
